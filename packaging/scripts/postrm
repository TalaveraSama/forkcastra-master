#!/bin/sh
# postrm de astra-webui
set -e

ACTION="$1"

case "$ACTION" in
    remove)
        if command -v systemctl >/dev/null 2>&1; then
            systemctl daemon-reload >/dev/null 2>&1 || true
        fi
        echo "[astra-webui] datos conservados en /var/lib/astra-webui (se borran con 'apt purge astra-webui')"
        ;;

    purge)
        rm -rf /var/lib/astra-webui
        rm -rf /var/log/astra-webui
        rm -f /etc/astra-webui/agent.token
        rm -f /etc/astra-webui/initial-admin-password
        rmdir /etc/astra-webui 2>/dev/null || true
        rm -f /etc/sudoers.d/astra-webui
        if command -v systemctl >/dev/null 2>&1; then
            systemctl daemon-reload >/dev/null 2>&1 || true
        fi
        if getent passwd astra >/dev/null 2>&1; then
            deluser astra >/dev/null 2>&1 || userdel astra >/dev/null 2>&1 || true
        fi
        if getent group astra >/dev/null 2>&1; then
            delgroup astra >/dev/null 2>&1 || groupdel astra >/dev/null 2>&1 || true
        fi
        ;;

    upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;
esac

exit 0
