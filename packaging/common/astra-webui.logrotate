/var/log/astra/astra.log {
    weekly
    rotate 8
    missingok
    notifempty
    compress
    delaycompress
    create 0640 astra astra
    sharedscripts
    postrotate
        # el core reabre el fichero de log al recibir SIGHUP
        if [ -f /run/astra.pid ]; then
            kill -HUP "$(cat /run/astra.pid)" 2>/dev/null || true
        fi
        systemctl kill -s HUP astra.service 2>/dev/null || true
    endscript
}

/var/log/astra-webui/*.log {
    weekly
    rotate 4
    missingok
    notifempty
    compress
    delaycompress
    create 0640 astra astra
    sharedscripts
    postrotate
        systemctl kill -s HUP astra-webui.service 2>/dev/null || true
    endscript
}
