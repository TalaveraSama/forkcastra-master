[Unit]
Description=Astra WebUI — panel administrativo web
Documentation=file:///usr/share/doc/astra-webui/INSTALL.md
After=network-online.target astra.service
Wants=network-online.target
# NO se usa PartOf=astra.service: al reiniciar astra desde el panel, systemd
# reiniciaría también el panel y la petición HTTP se cortaría antes de responder
# («Remote end closed connection without response»). Sin PartOf el panel sobrevive y
# puede informar del estado del agente (incluso si astra está parado).

[Service]
Type=simple
User=astra
Group=astra
WorkingDirectory=/var/lib/astra-webui
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/usr/share/astra-webui/panel
EnvironmentFile=-/etc/default/astra-webui
ExecStart=/usr/bin/python3 -m astra_webui --config /etc/astra-webui/panel.json
Restart=always
RestartSec=3
TimeoutStopSec=15

# Endurecimiento. OJO: systemd activa NoNewPrivileges en cuanto se usa cualquiera de
# estas opciones: ProtectKernelTunables, ProtectControlGroups, RestrictSUIDSGID,
# RestrictNamespaces, RestrictRealtime, LockPersonality, MemoryDenyWriteExecute,
# ProtectClock, ProtectKernelLogs, ProtectKernelModules o PrivateDevices.
# Con NoNewPrivileges activo, `sudo` no puede elevar privilegios y el panel no podría
# reiniciar astra.service («sudo: The "no new privileges" flag is set»), así que esas
# opciones NO se usan aquí: el panel necesita poder llamar a
# `sudo -n /usr/bin/systemctl restart astra.service` (regla de /etc/sudoers.d/astra-webui).
NoNewPrivileges=false
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/astra-webui /var/log/astra /var/log/astra-webui /etc/astra-webui /run

StandardOutput=journal
StandardError=journal
SyslogIdentifier=astra-webui

[Install]
WantedBy=multi-user.target
