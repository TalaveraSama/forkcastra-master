[Unit]
Description=Forkcastra IPTV engine
Documentation=https://github.com/TalaveraSama/forkcastra-master
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=forkcastra
Group=forkcastra
SupplementaryGroups=video
RuntimeDirectory=forkcastra
RuntimeDirectoryMode=0750
ExecStart=/usr/bin/forkcastra /etc/forkcastra/forkcastra.lua
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
NoNewPrivileges=true
PrivateTmp=true
# Keep /dev visible for optional DVB adapters; device permissions are controlled
# by the forkcastra user's group membership and udev rules.
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
ReadWritePaths=/var/lib/forkcastra /var/log/forkcastra
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
